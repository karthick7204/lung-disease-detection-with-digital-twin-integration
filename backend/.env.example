# ==========================================
# LungTwin AI Backend - Environment Configuration
# ==========================================

# Port the Express server listens on
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lungtwin?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lungtwin?retryWrites=true&w=majority

# Frontend URL allowed for CORS requests
CLIENT_URL=http://localhost:3000

# JSON Web Token (JWT) secret and expiration for Doctor Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_lungtwin
JWT_EXPIRES_IN=7d

# Upload configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
